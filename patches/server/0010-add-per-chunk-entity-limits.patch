From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: calvin <rukivverh@duck.com>
Date: Mon, 5 Oct 2026 19:05:45 +0200
Subject: [PATCH] add per-chunk entity limits


diff --git a/src/main/java/net/minecraft/server/level/ServerLevel.java b/src/main/java/net/minecraft/server/level/ServerLevel.java
index 092e2766d..9ded0698a 100644
--- a/src/main/java/net/minecraft/server/level/ServerLevel.java
+++ b/src/main/java/net/minecraft/server/level/ServerLevel.java
@@ -1173,6 +1173,9 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
             // ServerLevel.LOGGER.warn("Tried to add entity {} but it was marked as removed already", EntityTypes.getKey(entity.getType())); // CraftBukkit
             return false;
         } else {
+            if (spawnReason != null && this.isChunkOverLimit(entity, spawnReason)) {
+                return false;
+            }
             // SPIGOT-6415: Don't call spawn event when reason is null. For example when an entity teleports to a new world.
             if (spawnReason != null && !CraftEventFactory.doEntityAddEventCalling(this, entity, spawnReason)) {
                 return false;
@@ -1183,6 +1186,30 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         }
     }
 
+    private boolean isChunkOverLimit(Entity entity, CreatureSpawnEvent.SpawnReason reason) {
+        switch (reason) {
+            case NATURAL, SPAWNER, BREEDING, EGG -> {
+            }
+            default -> {
+                return false;
+            }
+        }
+
+        MobCategory category = entity.getType().getCategory();
+        int limit = switch (category) {
+            case CREATURE -> this.spigotConfig.chunkAnimalLimit;
+            case MONSTER -> this.spigotConfig.chunkMonsterLimit;
+            default -> -1;
+        };
+        if (limit < 0) {
+            return false;
+        }
+
+        ChunkPos pos = entity.chunkPosition();
+        AABB area = new AABB(pos.getMinBlockX(), this.getMinY(), pos.getMinBlockZ(), pos.getMaxBlockX() + 1, this.getMaxY(), pos.getMaxBlockZ() + 1);
+        return this.getEntitiesOfClass(Mob.class, area, mob -> mob.getType().getCategory() == category).size() >= limit;
+    }
+
     public boolean tryAddFreshEntityWithPassengers(Entity entity) {
         // CraftBukkit start
         return this.tryAddFreshEntityWithPassengers(entity, org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.DEFAULT);
diff --git a/src/main/java/org/spigotmc/SpigotWorldConfig.java b/src/main/java/org/spigotmc/SpigotWorldConfig.java
index e05f62e32..1d560e47d 100644
--- a/src/main/java/org/spigotmc/SpigotWorldConfig.java
+++ b/src/main/java/org/spigotmc/SpigotWorldConfig.java
@@ -227,6 +227,15 @@ public class SpigotWorldConfig
         log( "Mob Despawn Range: hard " + despawnHardLimit + " / soft " + despawnSoftLimit );
     }
 
+    public int chunkAnimalLimit = 48;
+    public int chunkMonsterLimit = 48;
+    private void entityLimits()
+    {
+        chunkAnimalLimit = getInt( "entity-limits.per-chunk.animals", chunkAnimalLimit );
+        chunkMonsterLimit = getInt( "entity-limits.per-chunk.monsters", chunkMonsterLimit );
+        log( "Entity Limits Per Chunk: animals " + chunkAnimalLimit + " / monsters " + chunkMonsterLimit );
+    }
+
     public int playerTrackingRange = 48;
     public int animalTrackingRange = 32;
     public int monsterTrackingRange = 32;
